@section Scripts {
    <script>
        function loadUsers() {
            $.getJSON('/Home/GetUsers', function (data) {
                var tbody = $('#usersTableBody');
                tbody.empty();
                if (data.length === 0) {
                    $('#usersTableSection').hide();
                    return;
                }
                $('#usersTableSection').show();
                $.each(data, function (i, u) {
                    var row = '<tr>';
                    row += '<td>' + u.id + '</td>';
                    row += '<td>' + u.name + '</td>';
                    row += '<td>' + u.email + '</td>';
                    row += '<td>' + u.gender + '</td>';
                    row += '<td>' + u.age + '</td>';
                    row += '<td>' + u.address + '</td>';
                    row += '<td>' + u.username + '</td>';
                    row += '<td>';
                    row += '<button class="btn btn-sm btn-info me-1" onclick="viewUser(' + u.id + ')" title="View"><i class="fas fa-eye"></i></button>';
                    row += '<button class="btn btn-sm btn-warning me-1" onclick="editUser(' + u.id + ')" title="Edit"><i class="fas fa-edit"></i></button>';
                    row += '<button class="btn btn-sm btn-danger" onclick="deleteUser(' + u.id + ')" title="Delete"><i class="fas fa-trash"></i></button>';
                    row += '</td>';
                    row += '</tr>';
                    tbody.append(row);
                });
            });
        }

        function viewUser(id) {
            $.getJSON('/Home/GetUser', { id: id }, function (res) {
                if (!res.id) { alert(res.message); return; }
                alert("ID: " + res.id + "\nName: " + res.name + "\nEmail: " + res.email +
                      "\nGender: " + res.gender + "\nAge: " + res.age +
                      "\nAddress: " + res.address + "\nUsername: " + res.username);
            });
        }

        function editUser(id) {
            $.getJSON('/Home/GetUser', { id: id }, function (res) {
                if (!res.id) { alert(res.message); return; }
                $('#regId').val(res.id);
                $('#regName').val(res.name);
                $('#regEmail').val(res.email);
                $('input[name="Gender"]').prop('checked', false);
                if (res.gender) $('#regGender' + res.gender).prop('checked', true);
                $('#regAge').val(res.age);
                $('#regAddress').val(res.address);
                $('#regUsername').val(res.username);
                $('#regPassword').val('');
                $('#regBtnText').text('Update');
                $('#btnCancel').show();
                $('#registerFormCard').show();
                $('#usersTableSection').show();
                $('#loginFormCard').hide();
                window.scrollTo(0, 0);
            });
        }

        function deleteUser(id) {
            if (!confirm('Delete user #' + id + '?')) return;
            $.ajax({
                url: '/Home/DeleteUser',
                type: 'POST',
                data: { id: id },
                success: function (res) {
                    if (res.success) {
                        alert(res.message);
                        loadUsers();
                    } else {
                        alert(res.message);
                    }
                }
            });
        }

        function resetForm() {
            $('#registerForm')[0].reset();
            $('#regBtnText').text('Create Account');
            $('#btnCancel').hide();
            $('#registerForm').validate().resetForm();
            $('.text-danger').empty();
        }

        $(function () {
            loadUsers();

            $('#registerForm').validate({
                rules: {
                    Name: 'required',
                    Email: { required: true, email: true },
                    Gender: 'required',
                    Age: { required: true, range: [18, 100] },
                    Address: 'required',
                    Username: 'required',
                    Password: { required: true, minlength: 6 }
                },
                messages: {
                    Name: 'Name is required.',
                    Email: { required: 'Email is required.', email: 'Invalid email format.' },
                    Gender: 'Gender is required.',
                    Age: { required: 'Age is required.', range: 'Age must be between 18 and 100.' },
                    Address: 'Address is required.',
                    Username: 'Username is required.',
                    Password: { required: 'Password is required.', minlength: 'Password must be at least 6 characters.' }
                },
                errorElement: 'span',
                errorClass: 'text-danger',
                highlight: function (el) {
                    $(el).addClass('input-validation-error');
                },
                unhighlight: function (el) {
                    $(el).removeClass('input-validation-error');
                },
                errorPlacement: function (err, el) {
                    if (el.attr('name') === 'Gender') {
                        err.insertAfter(el.closest('.d-flex'));
                    } else {
                        err.insertAfter(el);
                    }
                }
            });

            $('#loginToggle').on('click', function (e) {
                e.preventDefault();
                $('#homeContent').hide();
                $('#loginContent').show();
                $('#loginFormCard').show();
                $('#registerFormCard').hide();
                $('#usersTableSection').hide();
                window.scrollTo(0, 0);
            });

            $('#navbarResponsive .nav-link:not(#loginToggle)').on('click', function () {
                $('#homeContent').show();
                $('#loginContent').hide();
            });

            $('#showRegister').on('click', function () {
                $('#loginFormCard').hide();
                $('#registerFormCard').show();
                loadUsers();
                window.scrollTo(0, 0);
            });

            $('#showLogin').on('click', function () {
                $('#registerFormCard').hide();
                $('#usersTableSection').hide();
                $('#loginFormCard').show();
                window.scrollTo(0, 0);
            });

            $('#btnCancel').on('click', function () {
                resetForm();
            });

            $('#btnRegisterIndex').on('click', function () {
                var form = $('#registerForm');
                if (!form.valid()) return;

                var id = parseInt($('#regId').val());
                var name = $('#regName').val().trim();
                var email = $('#regEmail').val().trim();
                var gender = $('input[name="Gender"]:checked').val();
                var age = $('#regAge').val().trim();
                var address = $('#regAddress').val().trim();
                var username = $('#regUsername').val().trim();
                var password = $('#regPassword').val();

                var msg = "Name: " + name + "\n" +
                          "Email: " + email + "\n" +
                          "Gender: " + gender + "\n" +
                          "Age: " + age + "\n" +
                          "Address: " + address + "\n" +
                          "Username: " + username;

                var action = id === 0 ? "insert" : "update";
                if (!confirm(msg + "\n\nPress OK to " + action + ".")) return;

                var url = id === 0 ? '/Home/RegisterAjax' : '/Home/UpdateUser';
                var payload = {
                    Name: name,
                    Email: email,
                    Gender: gender,
                    Age: parseInt(age),
                    Address: address,
                    Username: username
                };
                if (id !== 0) payload.Id = id;
                if (password) payload.Password = password;

                $.ajax({
                    url: url,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function (res) {
                        if (res.success) {
                            alert(res.message);
                            resetForm();
                            loadUsers();
                        } else {
                            alert(res.message);
                        }
                    }
                });
            });
        });
    </script>
}
