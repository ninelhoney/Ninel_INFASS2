@section Scripts {
    <script>
        function loadUsers() {
            $.getJSON('/Home/GetUsers', function (data) {
                var tbody = $('#usersTableBody');
                tbody.empty();
                if (data.length === 0) {
                    $('#usersTableSection').hide();
                    return;
                }
                $('#usersTableSection').show();
                $.each(data, function (i, u) {
                    tbody.append(
                        '<tr>' +
                        '<td>' + u.id + '</td>' +
                        '<td>' + u.name + '</td>' +
                        '<td>' + u.email + '</td>' +
                        '<td>' + u.gender + '</td>' +
                        '<td>' + u.age + '</td>' +
                        '<td>' + u.address + '</td>' +
                        '<td>' + u.username + '</td>' +
                        '<td class="text-center"><div class="d-flex justify-content-center gap-1">' +
                        '<button class="btn btn-sm btn-info text-white btn-view" data-id="' + u.id + '" title="View"><i class="fas fa-eye"></i></button>' +
                        '<button class="btn btn-sm btn-warning text-white btn-edit" data-id="' + u.id + '" title="Edit"><i class="fas fa-edit"></i></button>' +
                        '<button class="btn btn-sm btn-danger btn-delete" data-id="' + u.id + '" data-name="' + u.name + '" title="Delete"><i class="fas fa-trash"></i></button>' +
                        '</div></td></tr>'
                    );
                });
            });
        }

        function showRegisterAlert(msg, type) {
            var alertDiv = $('#registerAlert');
            alertDiv.removeClass('d-none alert-success alert-danger').addClass('alert-' + type).text(msg);
        }

        function clearRegisterForm() {
            $('#regId').val(0);
            $('#regName, #regEmail, #regAge, #regAddress, #regUsername, #regPassword').val('');
            $('input[name="Gender"]').prop('checked', false);
        }

        $(function () {
            loadUsers();

            $('#loginToggle').on('click', function (e) {
                e.preventDefault();
                $('#homeContent').hide();
                $('#loginContent').show();
                $('#loginFormCard').show();
                $('#registerFormCard').hide();
                window.scrollTo(0, 0);
            });

            $('#navbarResponsive .nav-link:not(#loginToggle)').on('click', function () {
                $('#homeContent').show();
                $('#loginContent').hide();
            });

            $('#showRegister').on('click', function () {
                $('#loginFormCard').hide();
                $('#registerFormCard').show();
                loadUsers();
                window.scrollTo(0, 0);
            });

            $('#showLogin').on('click', function () {
                $('#registerFormCard').hide();
                $('#loginFormCard').show();
                window.scrollTo(0, 0);
            });

            // AJAX Register - show confirmation first
            var pendingRegisterData = null;

            $('#registerForm').on('submit', function (e) {
                e.preventDefault();
                var gender = $('input[name="Gender"]:checked').val();
                pendingRegisterData = {
                    Id: parseInt($('#regId').val()) || 0,
                    Name: $('#regName').val(),
                    Email: $('#regEmail').val(),
                    Gender: gender || '',
                    Age: parseInt($('#regAge').val()) || 0,
                    Address: $('#regAddress').val(),
                    Username: $('#regUsername').val(),
                    Password: $('#regPassword').val()
                };
                $('#confirmName').text(pendingRegisterData.Name);
                $('#confirmEmail').text(pendingRegisterData.Email);
                $('#confirmGender').text(pendingRegisterData.Gender || 'Not selected');
                $('#confirmAge').text(pendingRegisterData.Age || 'Not specified');
                $('#confirmAddress').text(pendingRegisterData.Address || 'Not specified');
                $('#confirmUsername').text(pendingRegisterData.Username);
                new bootstrap.Modal('#confirmRegisterModal').show();
            });

            // Confirm and insert
            $('#btnConfirmRegister').on('click', function () {
                if (!pendingRegisterData) return;
                $.ajax({
                    url: '/Home/RegisterAjax',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(pendingRegisterData),
                    success: function (res) {
                        bootstrap.Modal.getInstance(document.getElementById('confirmRegisterModal')).hide();
                        if (res.success) {
                            showRegisterAlert(res.message, 'success');
                            clearRegisterForm();
                            loadUsers();
                        } else {
                            showRegisterAlert(res.message, 'danger');
                        }
                        pendingRegisterData = null;
                    },
                    error: function () {
                        bootstrap.Modal.getInstance(document.getElementById('confirmRegisterModal')).hide();
                        showRegisterAlert('An error occurred. Please try again.', 'danger');
                        pendingRegisterData = null;
                    }
                });
            });

            // View User
            $(document).on('click', '.btn-view', function () {
                var id = $(this).data('id');
                $.getJSON('/Home/GetUser/' + id, function (u) {
                    if (u) {
                        $('#viewId').text(u.id);
                        $('#viewName').text(u.name);
                        $('#viewEmail').text(u.email);
                        $('#viewGender').text(u.gender);
                        $('#viewAge').text(u.age);
                        $('#viewAddress').text(u.address);
                        $('#viewUsername').text(u.username);
                        new bootstrap.Modal('#viewUserModal').show();
                    }
                });
            });

            // Edit User
            $(document).on('click', '.btn-edit', function () {
                var id = $(this).data('id');
                $.getJSON('/Home/GetUser/' + id, function (u) {
                    if (u) {
                        $('#editId').val(u.id);
                        $('#editName').val(u.name);
                        $('#editEmail').val(u.email);
                        $('#editAge').val(u.age);
                        $('#editAddress').val(u.address);
                        $('#editUsername').val(u.username);
                        $('#editPassword').val('');
                        if (u.gender === 'Male') {
                            $('#editGenderMale').prop('checked', true);
                        } else {
                            $('#editGenderFemale').prop('checked', true);
                        }
                        new bootstrap.Modal('#editUserModal').show();
                    }
                });
            });

            // Update User
            $('#btnUpdateUser').on('click', function () {
                var gender = $('input[name="EditGender"]:checked').val();
                var data = {
                    Id: parseInt($('#editId').val()),
                    Name: $('#editName').val(),
                    Email: $('#editEmail').val(),
                    Gender: gender || '',
                    Age: parseInt($('#editAge').val()) || 0,
                    Address: $('#editAddress').val(),
                    Username: $('#editUsername').val(),
                    Password: $('#editPassword').val()
                };
                $.ajax({
                    url: '/Home/UpdateUser',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    success: function (res) {
                        if (res.success) {
                            bootstrap.Modal.getInstance(document.getElementById('editUserModal')).hide();
                            loadUsers();
                        } else {
                            alert(res.message);
                        }
                    }
                });
            });

            // Delete User
            $(document).on('click', '.btn-delete', function () {
                $('#deleteId').val($(this).data('id'));
                $('#deleteUserName').text('User: ' + $(this).data('name'));
                new bootstrap.Modal('#deleteUserModal').show();
            });

            $('#btnConfirmDelete').on('click', function () {
                var id = $('#deleteId').val();
                $.ajax({
                    url: '/Home/DeleteUser',
                    type: 'POST',
                    data: { id: id },
                    success: function (res) {
                        if (res.success) {
                            bootstrap.Modal.getInstance(document.getElementById('deleteUserModal')).hide();
                            loadUsers();
                        } else {
                            alert(res.message);
                        }
                    }
                });
            });
        });
    </script>
}
