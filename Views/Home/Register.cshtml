@model Ninel_INFASS2.Models.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}
<nav class="navbar navbar-expand-lg bg-secondary text-uppercase fixed-top" id="mainNav">
    <div class="container">
        <a class="navbar-brand" href="#page-top">Start Bootstrap</a>
        <button class="navbar-toggler text-uppercase font-weight-bold bg-primary text-white rounded" type="button" data-bs-toggle="collapse" data-bs-target="#navbarResponsive" aria-controls="navbarResponsive" aria-expanded="false" aria-label="Toggle navigation">
            Menu
            <i class="fas fa-bars"></i>
        </button>
        <div class="collapse navbar-collapse" id="navbarResponsive">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item mx-0 mx-lg-1">
                    <a class="nav-link py-3 px-0 px-lg-3 rounded" href="#portfolio">Portfolio</a>
                </li>
                <li class="nav-item mx-0 mx-lg-1">
                    <a class="nav-link py-3 px-0 px-lg-3 rounded" href="#about">About</a>
                </li>
                <li class="nav-item mx-0 mx-lg-1">
                    <a class="nav-link py-3 px-0 px-lg-3 rounded" href="#contact">Contact</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<div class="glass-page" style="padding-top: 180px;">

    <div class="glass-card-wide">
        <div class="glass-header" style="background: linear-gradient(135deg, #1abc9c, #16a085);">
            <h2><i class="fas fa-user-plus me-2"></i>Create Account</h2>
            <p style="margin:0; font-size:0.9rem; opacity:0.7;">Join us today! Fill in the details below.</p>
        </div>

        <div class="glass-body">

            <form id="registerForm">
                <input type="hidden" id="regId" value="0" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" placeholder="Enter your full name" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" placeholder="example@email.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Gender</label>
                        <div class="d-flex gap-4 mt-1">
                            <div class="form-check">
                                <input asp-for="Gender" class="form-check-input" type="radio" value="Male" id="genderMale">
                                <label class="form-check-label" for="genderMale">Male</label>
                            </div>
                            <div class="form-check">
                                <input asp-for="Gender" class="form-check-input" type="radio" value="Female" id="genderFemale">
                                <label class="form-check-label" for="genderFemale">Female</label>
                            </div>
                        </div>
                        <span asp-validation-for="Gender" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Age" class="form-label"></label>
                        <input asp-for="Age" class="form-control" type="number" min="15" max="100" placeholder="Enter your age" />
                        <span asp-validation-for="Age" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Address" class="form-label"></label>
                    <textarea asp-for="Address" class="form-control" rows="3" placeholder="Enter your address"></textarea>
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Username" class="form-label"></label>
                        <input asp-for="Username" class="form-control" placeholder="Choose a username" />
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-4">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Choose a password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                </div>

                <button class="glass-btn glass-btn-primary" type="button" id="btnRegister">
                    <i class="fas fa-user-plus me-1"></i> <span id="regBtnText">Create Account</span>
                </button>
                <button class="glass-btn glass-btn-secondary" type="button" id="btnCancel" style="display:none;">
                    <i class="fas fa-times me-1"></i> Cancel
                </button>

            </form>

            <hr class="glass-divider" />

            <p class="glass-footer-text">
                Already have an account?
                <a asp-action="Login" class="glass-link">Login</a>
            </p>

        </div>
    </div>

    <div id="usersTableSection" class="glass-card-wide mt-4" style="display:none;">
        <div class="glass-header" style="background: linear-gradient(135deg, #34495e, #2c3e50);">
            <h2><i class="fas fa-users me-2"></i>Registered Users</h2>
            <p style="margin:0; font-size:0.9rem; opacity:0.7;">List of registered accounts.</p>
        </div>
        <div class="glass-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Gender</th>
                            <th>Age</th>
                            <th>Address</th>
                            <th>Username</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="usersTableBody">
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script>
        function loadUsers() {
            $.getJSON('/ViewAll', function (data) {
                var tbody = $('#usersTableBody');
                tbody.empty();
                if (data.length === 0) {
                    $('#usersTableSection').hide();
                    return;
                }
                $('#usersTableSection').show();
                $.each(data, function (i, u) {
                    var row = '<tr>';
                    row += '<td>' + u.id + '</td>';
                    row += '<td>' + u.fullName + '</td>';
                    row += '<td>' + u.email + '</td>';
                    row += '<td>' + u.gender + '</td>';
                    row += '<td>' + u.age + '</td>';
                    row += '<td>' + u.address + '</td>';
                    row += '<td>' + u.username + '</td>';
                    row += '<td>';
                    row += '<button class="btn btn-sm btn-warning me-1" onclick="editUser(' + u.id + ')" title="Edit"><i class="fas fa-edit"></i></button>';
                    row += '<button class="btn btn-sm btn-danger" onclick="deleteUser(' + u.id + ')" title="Delete"><i class="fas fa-trash"></i></button>';
                    row += '</td>';
                    row += '</tr>';
                    tbody.append(row);
                });
            });
        }

        function editUser(id) {
            $.getJSON('/GetUser', { id: id }, function (res) {
                if (!res.id) { alert(res.message); return; }
                $('#regId').val(res.id);
                $('#FullName').val(res.fullName);
                $('#Email').val(res.email);
                $('input[name="Gender"]').prop('checked', false);
                if (res.gender) $('input[name="Gender"][value="' + res.gender + '"]').prop('checked', true);
                $('#Age').val(res.age);
                $('#Address').val(res.address);
                $('#Username').val(res.username);
                $('#Password').val('');
                $('#regBtnText').text('Update');
                $('#btnCancel').show();
                $('#usersTableSection').show();
                window.scrollTo(0, 0);
            });
        }

        function deleteUser(id) {
            if (!confirm('Delete user #' + id + '?')) return;
            $.ajax({
                url: '/Delete',
                type: 'POST',
                data: { id: id },
                success: function (res) {
                    if (res.success) {
                        alert(res.message);
                        loadUsers();
                    } else {
                        alert(res.message);
                    }
                }
            });
        }

        function resetForm() {
            $('#registerForm')[0].reset();
            $('#regId').val('0');
            $('#regBtnText').text('Create Account');
            $('#btnCancel').hide();
            $('#registerForm').validate().resetForm();
            $('.field-validation-error').removeClass('field-validation-error').addClass('field-validation-valid');
            $('.input-validation-error').removeClass('input-validation-error');
        }

        $(function () {
            loadUsers();

            $.validator.setDefaults({ ignore: [] });

            $("#btnRegister").click(function () {
                var form = $("#registerForm");
                form.validate();
                if (!form.valid()) return;

                var id = parseInt($('#regId').val()) || 0;
                var name = $("#FullName").val().trim();
                var email = $("#Email").val().trim();
                var gender = $('input[name="Gender"]:checked').val();
                var age = $("#Age").val().trim();
                var address = $("#Address").val().trim();
                var username = $("#Username").val().trim();
                var password = $("#Password").val();

                var url = id === 0 ? '/Register' : '/Update?id=' + id;
                var payload = {
                    FullName: name,
                    Email: email,
                    Gender: gender,
                    Age: parseInt(age),
                    Address: address,
                    Username: username
                };
                if (password) payload.Password = password;

                $.ajax({
                    url: url,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function (res) {
                        if (res.success) {
                            if (id === 0) {
                                showSqlAlert(res);
                                alert('User successfully inserted.');
                            } else {
                                alert(res.message);
                            }
                            resetForm();
                            loadUsers();
                        } else {
                            alert(res.message);
                        }
                    }
                });
            });

            $('#btnCancel').on('click', function () {
                resetForm();
            });
        });
    </script>
}
